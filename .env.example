# Copy to .env locally or configure these values as deployment environment variables.
PORT=3000
HOST=127.0.0.1
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Owner-provided public treasury addresses
